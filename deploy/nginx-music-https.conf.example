# 电音档案 · HTTPS 反向代理示例
#
# 用法：把 em.example.com 换成你的域名，复制到 /etc/nginx/conf.d/electronic-music.conf
# 证书先用 certbot 申请（见 deploy/README.md），再 nginx -t && systemctl reload nginx
#
# 同机还有 /cet4/、/french/、/api/ 等服务；这里只新增独立 server 块，不改动原配置。

server {
    listen 80;
    server_name em.example.com;

    # certbot --webroot 的验证目录
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    # nginx < 1.25.1 改成：listen 443 ssl http2;
    http2 on;
    server_name em.example.com;

    ssl_certificate     /etc/letsencrypt/live/em.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/em.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # 站点根目录与现网保持一致
    location = /music/sw.js {
        alias /var/www/electronic-music/serve/sw.js;
        default_type application/javascript;
        add_header Cache-Control "no-cache";
    }

    location /music/assets/ {
        alias /var/www/electronic-music/serve/assets/;
        add_header Cache-Control "public, max-age=31536000, immutable";
        gzip on;
        gzip_types image/svg+xml application/json audio/mpeg;
        gzip_min_length 1024;
    }

    location /music/ {
        alias /var/www/electronic-music/serve/;
        index index.html;
        try_files $uri $uri/ /music/index.html;

        # 页面与数据随发版变化，交给 Service Worker 管理缓存
        add_header Cache-Control "no-cache";

        gzip on;
        gzip_min_length 1024;
        gzip_types text/css application/javascript application/json text/plain image/svg+xml;
    }

    location = / {
        return 302 /music/;
    }
}
